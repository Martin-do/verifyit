# Optional evidence retrieval. VerifyIt itself is provider-neutral.
# Select a registered provider id. Leave blank to auto-detect a configured provider.
VERIFYIT_EVIDENCE_PROVIDER=

# Bundled provider authentication uses OAuth/Application Default Credentials (ADC).
# Preferred local/production setup: configure ADC outside the repository.
# Google-auth will also honor GOOGLE_APPLICATION_CREDENTIALS automatically.
#
# Optional short-lived developer override only. Never commit a real access token.
VERIFYIT_GOOGLE_ACCESS_TOKEN=
