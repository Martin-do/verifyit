# VerifyIt is provider-neutral. Select one registered evidence provider.
# Recommended local MVP: tavily
# Self-hosted/open option: searxng
# Optional legacy adapter: google_factcheck
VERIFYIT_EVIDENCE_PROVIDER=

# Tavily: simple API-key setup for general web evidence retrieval.
TAVILY_API_KEY=

# SearXNG: point VerifyIt to an operator-controlled instance with JSON search enabled.
SEARXNG_BASE_URL=

# Optional Google published-fact-check adapter.
# Preferred authentication uses Application Default Credentials outside the repository.
# Short-lived developer override only; never commit a real access token.
VERIFYIT_GOOGLE_ACCESS_TOKEN=
